# ========================================================================
# AWS SIMULADOS (CLF-C02) - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para .env ou .env.local e configure seus valores locais.
# ATENÇÃO: NUNCA insira credenciais de produção ou exponha este arquivo com segredos reais.
# ========================================================================

# Ambiente de execução (development | production | test)
NODE_ENV=development

# URL da aplicação Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conexão com o banco de dados PostgreSQL instalado localmente
# Substitua 'usuario', 'senha' e 'nome_do_banco' conforme sua instalação local do PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aws_simulado_db?schema=public"

# Chave secreta usada pelo Better Auth para assinar sessões e tokens (mínimo de 32 caracteres aleatórios)
# Você pode gerar uma chave aleatória com: openssl rand -base64 32
BETTER_AUTH_SECRET="substitua-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres"

# URL base do Better Auth (em desenvolvimento local deve apontar para http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# Expiração de sessão por inatividade e validade máxima
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_MAX_DAYS=7

# Chave do gerador de questões (usada somente no servidor, quando faltarem questões inéditas)
# Obtenha gratuitamente no Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy_placeholder_para_etapa_posterior"

# Modelo do gerador de questões (opcional). Se vazio, tenta gemini-3.5-flash e depois gemini-flash-lite-latest
GEMINI_MODEL=
